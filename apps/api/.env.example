# Copy to .env and fill in. Never commit .env.
PORT=4000
# MongoDB Atlas (or any replica set — transactions require one). When set, the API
# uses MongoDB and REFUSES TO BOOT if it is unreachable (fail closed: never a
# silent in-memory fallback for voting storage). NODE_ENV=production requires it.
MONGODB_URI=
# Meta Muse Spark (OpenAI-compatible) for the read-only integrity assistant.
# Without a key the assistant degrades to deterministic rules-only analysis.
MUSE_SPARK_API_KEY=
# Optional overrides; defaults shown.
MUSE_SPARK_BASE_URL=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_SPARK_TIMEOUT_MS=20000
# Comma-separated allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173
# WebAuthn relying party. Localhost defaults work for local development.
# Production MUST use https: set WEBAUTHN_ORIGIN=https://<host>,
# WEBAUTHN_RP_ID=<host>, and COOKIE_SECURE=true.
WEBAUTHN_RP_NAME=CivicProof AI
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SESSION_TTL_MS=3600000
# Optional: snapshot the memory store to this JSON file so ballots, passkeys,
# audit history, and Semaphore groups survive API restarts. Sessions and
# challenges stay ephemeral. Prefer MONGODB_URI for real durability.
STORE_FILE=
# Organizer access. Single-use token that authorises creation of the founding
# organizer account via POST /api/organizer/setup (consumed atomically, checked
# in constant time). Unset disables bootstrap entirely — no public signup path.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ORGANIZER_SETUP_TOKEN=
ORGANIZER_SESSION_TTL_MS=3600000
# Public README demo organizer logins (organizer-1/2/3) for local testing.
# Explicit opt-in only; the API REFUSES TO BOOT with this in production.
DEMO_ORGANIZERS=false
