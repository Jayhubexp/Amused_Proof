{
  "name": "civicproof-ai",
  "version": "0.1.0",
  "private": true,
  "description": "CivicProof AI — privacy-preserving digital election research prototype (NOT production election software).",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "test": "npm run test -w apps/api",
    "build": "npm run build -w apps/web"
  },
  "engines": {
    "node": ">=20"
  }
}
